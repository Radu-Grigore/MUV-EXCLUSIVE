# Old address rbsolutions.ro/muv-exclusive → the site's own domain.
# Goes in htdocs/muv-exclusive/ (it replaces everything that was there): every page moves permanently
# to the same path on https://muvexclusive.ro, so links and search results carry over.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ https://muvexclusive.ro/$1 [R=301,L,NE]
</IfModule>

<IfModule !mod_rewrite.c>
    Redirect 301 /muv-exclusive https://muvexclusive.ro
</IfModule>
