# Used when the whole Laravel project is uploaded into public_html (cPanel).
# Every request is served from the public/ folder, so .env, vendor/, storage/ etc. stay unreachable.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force the domain without www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Serve everything from public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Never serve dotfiles (.env, .git …) even if the rewrite module is missing
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes
